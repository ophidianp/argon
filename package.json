{
  "name": "argon",
  "private": true,
  "version": "1.0.1",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && vite build",
    "start": "node scripts/start.mjs",
    "desktop": "vite build && electron desktop/main.cjs",
    "test": "node --test test/ && node server/usage.mjs && node server/scan.mjs && node server/docs.mjs",
    "postinstall": "node scripts/postinstall.mjs",
    "dist": "vite build && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.1",
    "@xterm/headless": "^6.0.0",
    "electron-updater": "^6.8.11",
    "node-pty": "^1.1.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "1.2.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.12.0",
    "codemirror": "6.0.2",
    "dompurify": "3.4.17",
    "electron": "44.9.3",
    "electron-builder": "26.18.0",
    "lucide-react": "^1.61.0",
    "marked": "18.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "zustand": "^5.0.16"
  },
  "description": "All your coding agents on one board, on Windows. Real terminals, side by side.",
  "author": "ophidianp",
  "main": "desktop/main.cjs",
  "build": {
    "appId": "io.github.ophidianp.argon",
    "productName": "Argon",
    "copyright": "Copyright © 2026 Pavan Nemani. All rights reserved. Based on vibeboard, © 2026 Riccardo Niccolò Agosti (MIT).",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "desktop/**",
      "server/**",
      "shared/**",
      "dist/**",
      "package.json",
      "!node_modules/node-pty/third_party/**"
    ],
    "asar": false,
    "npmRebuild": false,
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "target": [
        "dmg"
      ],
      "identity": null,
      "artifactName": "${productName}-mac-${arch}.${ext}",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Argon listens only while you dictate a command."
      }
    },
    "dmg": {
      "title": "vibeboard ${version}"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-${version}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Argon"
    },
    "publish": {
      "provider": "github",
      "owner": "ophidianp",
      "repo": "argon"
    }
  }
}
